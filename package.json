{
  "name": "test-detective",
  "version": "0.1.0",
  "description": "AI-assisted investigation of failed Playwright tests.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:repeat": "playwright test --repeat-each=5",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:mcp": "node --test --test-reporter=spec \"src/mcp/test/*.test.ts\"",
    "mcp": "node src/mcp/main.ts",
    "test:agent": "node --test --test-reporter=spec \"src/agent/test/*.test.ts\"",
    "investigate": "node src/agent/main.ts",
    "eval": "node src/eval/main.ts",
    "test:eval": "node --test --test-reporter=spec \"src/eval/test/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/yauzl": "3.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@modelcontextprotocol/server": "^2.3.1",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  }
}
